{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "Capability for the main windows",
	"windows": ["main"],
	"permissions": [
		"core:default",
		"os:default",
		"os:allow-locale",
		"opener:default",
		"updater:default",
		"cluster-vpn:default",
		"log:default",
		"clipboard-manager:default",
		"clipboard-manager:allow-write-text",
		"clipboard-manager:allow-read-text"
	]
}
